[Unit]
Description=Scout marketplace deal monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scout
Group=scout
WorkingDirectory=/opt/scout
ExecStart=/usr/bin/node /opt/scout/dist-server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

Environment=NODE_ENV=production
Environment=SCOUT_HOST=127.0.0.1
# Refuse to start without SCOUT_PASSWORD_HASH/SCOUT_API_TOKENS: a loopback
# bind behind a reverse proxy is still published to the internet.
Environment=SCOUT_AUTH=on
Environment=TZ=Europe/Warsaw
Environment=SCOUT_DB_PATH=/var/lib/scout/scout.sqlite
EnvironmentFile=-/etc/scout/scout.env

UMask=0077
StateDirectory=scout
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scout
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
