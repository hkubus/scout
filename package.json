{
  "name": "scout-deal-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx server/index.ts\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && npm run build:server && vite build && node scripts/precompress.mjs",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --target node22",
    "start": "node dist-server/index.js",
    "marketplace:login": "tsx scripts/marketplace-login.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "test:compose": "bash scripts/compose-smoke.sh",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "extension:lint": "npx --yes web-ext@8 lint --source-dir extension",
    "extension:build": "npx --yes web-ext@8 build --source-dir extension --artifacts-dir dist-extension --overwrite-dest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fastify": "^5.3.3",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
