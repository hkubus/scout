PORT=3001
NODE_ENV=production
TZ=Europe/Warsaw
SCOUT_HOST=127.0.0.1
SCOUT_DB_PATH=./data/scout.sqlite
# Required. Generate with: openssl rand -hex 32 (placeholders are rejected).
# Rotating SCOUT_SECRET invalidates encrypted DB credentials (Discord/ntfy/OpenRouter/marketplace sessions).
SCOUT_SECRET=
SCOUT_VERSION=1.0.0

# --- Authentication (see README "Authentication and internet deployment") ---
# `on` refuses to start without credentials even on loopback. Keep it on for
# any deployment reachable through a reverse proxy or tunnel.
SCOUT_AUTH=on
# Dashboard password hash: node scripts/hash-password.mjs (single-quote it).
SCOUT_PASSWORD_HASH=
# Comma-separated tokens for MCP clients/scripts and dashboard sign-in (node scripts/generate-api-token.mjs).
# Tokens have full operator access, including Settings → System update.
SCOUT_API_TOKENS=
# Behind a reverse proxy: `loopback` for a proxy on the same host (systemd),
# `uniquelocal` under Docker Compose (the proxy connects from a bridge IP).
SCOUT_TRUST_PROXY=
# Public HTTPS origin, e.g. https://scout.example.com (forces Secure cookies + HSTS).
SCOUT_PUBLIC_ORIGIN=
# Extra hostnames accepted while auth is off (e.g. scout.lan); IPs and localhost always are.
SCOUT_ALLOWED_HOSTS=

# Compose only: shared secret between Scout and the Browserless container.
# SCOUT_BROWSER_TOKEN=

# Optional comma-separated origins for a separately hosted frontend. With auth
# enabled it must use a SCOUT_API_TOKENS bearer token, not the session cookie.
SCOUT_CORS_ORIGIN=
# Optional OpenRouter configuration for headless deployments.
SCOUT_OPENROUTER_API_KEY=
SCOUT_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Legacy fallback (prefer SCOUT_OPENROUTER_API_KEY).
# OPENROUTER_API_KEY=
# Optional Jev integration. Live is the default whenever an OpenRouter key is
# available: Jev decides relevance/verification with vision escalation on
# unsure judgments.
# SCOUT_JEV_MODE=legacy opts back out to DeepSeek for everything;
# SCOUT_JEV_MODE=shadow measures Jev vs DeepSeek agreement into jev_shadow_log
# without changing behavior. First live scan re-evaluates cached rows because
# caches are scoped per model.
# SCOUT_JEV_MODE=legacy
# SCOUT_JEV_MODEL=~typesafe/jev-latest
# SCOUT_VISION_MODEL=deepseek/deepseek-v4.1-flash
# Concurrent Jev relevance/rescue checks per search (default 6, max 16).
# SCOUT_JEV_CONCURRENCY=6
# Optional browser / runtime overrides.
# SCOUT_BROWSER_WS=ws://chromium:3000?token=...
# SCOUT_CHROMIUM_PATH=/usr/bin/chromium
# SCOUT_DIST_PATH=./dist
# SCOUT_SEED_DEMO=false
# SCOUT_SKIP_MIGRATION_BACKUP=false
# Read-only /api/debug/* endpoints and scout_debug_* MCP tools. Unset: on only
# while auth is off (local development). Set true to enable with auth.
# SCOUT_DEBUG_API=false
